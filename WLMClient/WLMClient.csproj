<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(LinkoraTargetFramework)</TargetFramework>
    <RootNamespace>WLMClient</RootNamespace>
    <Version>1.1.0</Version>
    <!-- Otherwise the SDK appends the git commit to InformationalVersion, which is not something
         to show a user at the foot of the window. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>WLMClient</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;win-x86</RuntimeIdentifiers>
    <!-- The ported code keeps the original's very liberal use of unused locals and
         empty event handlers; those warnings are noise here. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0067;CS0414;CS8032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Content\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Messenger.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>

    <!-- Translations ship as loose files so anyone can add or edit a language without a rebuild. -->
    <None Include="Languages\**\*.lang">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Languages\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WLMData\WLMData.csproj" />
    <ProjectReference Include="..\WLMNet\WLMNet.csproj" />
  </ItemGroup>

</Project>
